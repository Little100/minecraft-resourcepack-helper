    "test:client:cache": "node tools/client-jar-cache-test.cjs",
    "test:editor:refinements": "node tools/editor-refinements-test.cjs",
    "test:mcp": "node tools/mcp-startup-test.cjs && node tools/mcp-painting-test.cjs && node tools/mcp-test.cjs",
    "test:mcp:vscode": "node tools/mcp-vscode-test.cjs",
    "test:paint:nearby": "node tools/paint-nearby-test.cjs",
    "test:collaboration:root": "node tools/collaboration-host-root-test.cjs",
    "test:collaboration:bundle": "node tools/openp2p-bundle-test.cjs",
    "test:paint:guides": "node tools/smart-guides-test.cjs",
    "test:paint:nearby:ui": "node tools/paint-nearby-browser-test.cjs",
    "test:paint:guides:ui": "node tools/smart-guides-browser-test.cjs",
    "test:webview:repair": "node tools/webview-auto-repair-test.cjs && node tools/webview-recovery-host-test.cjs && node tools/webview-recovery-test.cjs",
    "test:blockbench": "node tools/blockbench-open-test.cjs && node tools/blockbench-preview-browser-test.cjs",
    "test:preview:uv": "node tools/preview-default-uv-test.cjs",
    "test:preview:generated": "node tools/generated-base-test.cjs && node tools/generated-reference-test.cjs && node tools/generated-base-browser-test.cjs && node tools/generated-reference-browser-test.cjs && node tools/alpha-model-optimizer-test.cjs",
    "test:collaboration:startup": "node tools/p2p-port-test.cjs && node tools/collaboration-tls-test.cjs && node tools/collaboration-startup-flow-test.cjs",
    "test:collaboration:startup:vscode": "node tools/collaboration-startup-vscode-host.cjs",
    "test:collaboration:tls": "node tools/collaboration-tls-test.cjs",
    "test:gui": "tsc -p tsconfig.test.json --outDir tmp/test-build && mocha tmp/test-build/test/suite/guiPreview.test.js --timeout 15000 && node tools/gui-preview-host-test.cjs && node tools/gui-preview-browser-test.cjs && node tools/gui-preview-routing-test.cjs",
    "test:resource-authoring": "node tools/resource-authoring-test.cjs && node tools/resource-templates-host-test.cjs && node tools/resource-authoring-browser-test.cjs",
    "test:preview:restore": "node tools/preview-restoration-vscode-test.cjs",
    "test:vanilla:authoring": "node tools/vanilla-authoring-test.cjs && node tools/vanilla-authoring-host-test.cjs",
    "test:vanilla:authoring:ui": "node tools/vanilla-authoring-browser-test.cjs",
    "test:collaboration:multipack": "node tools/collaboration-multipack-test.cjs",
    "test:collaboration:live:p2p": "node tools/collaboration-live-p2p-test.cjs"
