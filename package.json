    "block-model-renderer": "2.20.0",
    "blockly": "^13.3.0",
    "buffer": "5.7.1",
    "commander": "^14.0.3",
    "diff": "^8.0.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "image-size": "2.0.4",
    "isomorphic-git": "^1.44.2",
    "jsonc-parser": "^3.3.1",
    "pako": "2.1.0",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
