    "test:pack:ui": "node build.js && node tools/build-web.cjs && node tools/pack-tools-host-test.cjs && node tools/pack-tools-browser-test.cjs",
    "test:web:ui": "node tools/build-web.cjs && node tools/web-browser-test.cjs",
    "test:watermark:ui": "node build.js && node tools/watermark-browser-test.cjs",
    "package:web": "node tools/build-web.cjs && node tools/package-web.cjs",
