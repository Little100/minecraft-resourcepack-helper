    "test:pack:completion": "tsc -p tsconfig.test.json --outDir tmp/test-build && mocha tmp/test-build/test/suite/clientPackMetadata.test.js tmp/test-build/test/suite/resourceNames.test.js --timeout 15000 && node tools/client-pack-completion-test.cjs",
