    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:**/pack.mcmeta",
    "workspaceContains:**/assets/*/textures",
    "onCommand:mcrh.showTutorial",
    "onCommand:mcrh.refreshPack",
    "onCommand:mcrh.scanPacks",
    "onCommand:mcrh.createExample",
    "onCommand:mcrh.createStructure",
    "onCommand:mcrh.scaffoldPack",
    "onCommand:mcrh.extractClientAssets",
    "onCommand:mcrh.previewTexture",
    "onCommand:mcrh.refreshPackFormats",
    "onCommand:mcrh.convertAnimation",
    "onCommand:mcrh.writeOptiFineTutorial",
    "onCommand:mcrh.openSyntaxPreview",
    "onCommand:mcrh.checkFfmpeg",
    "onCommand:mcrh.pickFfmpegPath",
    "onCommand:mcrh.openInBlockbench",
    "onCommand:mcrh.pickBlockbenchPath",
    "onCommand:mcrh.openAdvancedWorkbench",
    "onView:mcrh.sidebar",
    "onStartupFinished",
    "onCommand:mcrh.addScanFolder",
    "onCommand:mcrh.configureScan",
    "workspaceContains:**/assets/*/textures/**",
    "workspaceContains:**/assets/*/font/*.json",
    "onCommand:mcrh.previewVanillaModel",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onCommand:mcrh.exportPackZip",
    "onCommand:mcrh.diagnosePack",
    "onCommand:mcrh.convertPackVersion",
    "onCommand:mcrh.openCollaboration",
    "onCommand:mcrh.openGit",
    "onView:mcrh.todos",
    "onCommand:mcrh.showLogs",
    "onCommand:mcrh.showWebviewDiagnostics",
    "onCommand:mcrh.exportWebviewDiagnostics",
    "onCommand:mcrh.webviewReloadAdvice",
    "onCommand:mcrh.recoverWebviews",
    "onCommand:mcrh.previewGui",
    "onWebviewPanel:mcrh.preview",
    "onWebviewPanel:mcrh.syntaxPreview",
    "onWebviewPanel:mcrh.vanillaPreview",
    "onWebviewPanel:mcrh.guiPreview",
    "onCommand:mcrh.createCustomModelData",
    "onCommand:mcrh.createFontTemplate",
    "onCommand:mcrh.insertFontGlyph",
    "onCommand:mcrh.createVanillaTemplate",
    "onCommand:mcrh.applyJsonFamily"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcrh.showTutorial",
        "title": "%command.showTutorial%",
        "icon": "$(book)"
      },
      {
        "command": "mcrh.refreshPack",
        "title": "%command.refreshPack%"
      },
      {
        "command": "mcrh.scanPacks",
        "title": "%command.scanPacks%",
        "icon": "$(refresh)"
      },
      {
        "command": "mcrh.createExample",
        "title": "%command.createExample%",
        "icon": "$(file-add)"
      },
      {
        "command": "mcrh.createStructure",
        "title": "%command.createStructure%",
        "icon": "$(new-folder)"
      },
      {
        "command": "mcrh.scaffoldPack",
        "title": "%command.scaffoldPack%",
        "icon": "$(tools)"
      },
      {
        "command": "mcrh.extractClientAssets",
        "title": "%command.extractClientAssets%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcrh.previewTexture",
        "title": "%command.previewTexture%",
        "icon": "$(preview)"
      },
      {
        "command": "mcrh.refreshPackFormats",
        "title": "%command.refreshPackFormats%"
      },
      {
        "command": "mcrh.convertAnimation",
        "title": "%command.convertAnimation%",
        "icon": "$(file-media)"
      },
      {
        "command": "mcrh.writeOptiFineTutorial",
        "title": "%command.writeOptiFineTutorial%"
      },
      {
        "command": "mcrh.openSyntaxPreview",
        "title": "%command.openSyntaxPreview%",
        "icon": "$(open-preview)"
      },
      {
        "command": "mcrh.checkFfmpeg",
        "title": "%command.checkFfmpeg%"
      },
      {
        "command": "mcrh.pickFfmpegPath",
        "title": "%command.pickFfmpegPath%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcrh.openInBlockbench",
        "title": "%command.openInBlockbench%",
        "icon": "$(link-external)"
      },
      {
        "command": "mcrh.pickBlockbenchPath",
        "title": "%command.pickBlockbenchPath%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcrh.openAdvancedWorkbench",
        "title": "%command.openAdvancedWorkbench%",
        "icon": "$(beaker)"
      },
      {
        "command": "mcrh.addScanFolder",
        "title": "%command.addScanFolder%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mcrh.configureScan",
        "title": "%command.configureScan%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mcrh.previewVanillaModel",
        "title": "%command.previewVanillaModel%",
        "icon": "$(open-preview)"
      },
      {
        "command": "mcrh.exportPackZip",
        "title": "%command.exportPackZip%",
        "icon": "$(export)"
      },
      {
        "command": "mcrh.diagnosePack",
        "title": "%command.diagnosePack%",
        "icon": "$(pulse)"
      },
      {
        "command": "mcrh.convertPackVersion",
        "title": "%command.convertPackVersion%",
        "icon": "$(versions)"
      },
      {
        "command": "mcrh.openCollaboration",
        "title": "%command.openCollaboration%",
        "icon": "$(source-control)"
      },
      {
        "command": "mcrh.openGit",
        "title": "%command.openGit%"
      },
      {
        "command": "mcrh.showLogs",
        "title": "%command.showLogs%"
      },
      {
        "command": "mcrh.showWebviewDiagnostics",
        "title": "%command.showWebviewDiagnostics%"
      },
      {
        "command": "mcrh.exportWebviewDiagnostics",
        "title": "%command.exportWebviewDiagnostics%"
      },
      {
        "command": "mcrh.webviewReloadAdvice",
        "title": "%command.webviewReloadAdvice%"
      },
      {
        "command": "mcrh.configureMcp",
        "title": "%command.configureMcp%"
      },
      {
        "command": "mcrh.copyMcpSetup",
        "title": "%command.copyMcpSetup%"
      },
      {
        "command": "mcrh.recoverWebviews",
        "title": "%command.recoverWebviews%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mcrh.previewGui",
        "title": "%command.previewGui%",
        "icon": "$(layout)"
      },
      {
        "command": "mcrh.createCustomModelData",
        "title": "%command.createCustomModelData%"
      },
      {
        "command": "mcrh.createFontTemplate",
        "title": "%command.createFontTemplate%"
      },
      {
        "command": "mcrh.insertFontGlyph",
        "title": "%command.insertFontGlyph%"
      },
      {
        "command": "mcrh.createVanillaTemplate",
        "title": "%command.createVanillaTemplate%"
      },
      {
        "command": "mcrh.applyJsonFamily",
        "title": "%command.applyJsonFamily%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcrh.createExample",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@1"
        },
        {
          "command": "mcrh.convertAnimation",
          "when": "resourceExtname =~ /^(\\.gif|\\.png|\\.apng|\\.mp4|\\.mov|\\.m4v)$/",
          "group": "2_workspace@2"
        },
        {
          "command": "mcrh.previewTexture",
          "when": "resourceExtname == .png",
          "group": "2_workspace@3"
        },
        {
          "command": "mcrh.scaffoldPack",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@4"
        },
        {
          "command": "mcrh.writeOptiFineTutorial",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@5"
        },
        {
          "command": "mcrh.openInBlockbench",
          "when": "resourceExtname =~ /^\\.bbmodel$/i || (resourceExtname =~ /^\\.json$/i && resourcePath =~ /[\\\\/]models[\\\\/]/)",
          "group": "2_workspace@6"
        },
        {
          "command": "mcrh.previewVanillaModel",
          "when": "resourceExtname == .json || resourceExtname == .png",
          "group": "mcrh@4"
        },
        {
          "command": "mcrh.exportPackZip",
          "when": "explorerResourceIsFolder",
          "group": "mcrh@5"
        },
        {
          "command": "mcrh.previewGui",
          "when": "resourceExtname == .png || resourceFilename == pack.mcmeta || explorerResourceIsFolder",
          "group": "mcrh@5"
        }
      ],
      "view/title": [
        {
          "command": "mcrh.openAdvancedWorkbench",
          "when": "view == mcrh.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "mcrh.scanPacks",
          "when": "view == mcrh.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "mcrh.scaffoldPack",
          "when": "view == mcrh.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "mcrh.extractClientAssets",
          "when": "view == mcrh.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "mcrh.createExample",
          "when": "view == mcrh.sidebar",
          "group": "navigation@5"
        },
        {
          "command": "mcrh.showTutorial",
          "when": "view == mcrh.sidebar",
          "group": "navigation@6"
        },
        {
          "command": "mcrh.exportPackZip",
          "when": "view == mcrh.sidebar",
          "group": "navigation@7"
        },
        {
          "command": "mcrh.openCollaboration",
          "when": "view == mcrh.sidebar",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "mcrh.createExample",
          "when": "view == mcrh.sidebar && viewItem == mcrhTemplate",
          "group": "inline@1"
        },
        {
          "command": "mcrh.createStructure",
          "when": "view == mcrh.sidebar && viewItem == mcrhStructureMissing",
          "group": "inline@1"
        },
        {
          "command": "mcrh.scaffoldPack",
          "when": "view == mcrh.sidebar && viewItem == mcrhPack",
          "group": "inline@1"
        },
        {
          "command": "mcrh.exportPackZip",
          "when": "view == mcrh.sidebar && viewItem == mcrhPack",
          "group": "mcrh@2"
        },
        {
          "command": "mcrh.diagnosePack",
          "when": "view == mcrh.sidebar && viewItem == mcrhPack",
          "group": "mcrh@3"
        },
        {
          "command": "mcrh.convertPackVersion",
          "when": "view == mcrh.sidebar && viewItem == mcrhPack",
          "group": "mcrh@3"
        },
        {
          "command": "mcrh.previewGui",
          "when": "viewItem == mcrhPack",
          "group": "mcrh@5"
        }
      ],
      "editor/title": [
        {
          "command": "mcrh.convertAnimation",
          "when": "resourceExtname =~ /^(.gif|.apng|.mp4|.mov|.m4v)$/",
          "group": "navigation@1"
        },
        {
          "command": "mcrh.previewTexture",
          "when": "resourceExtname == .png",
          "group": "navigation@2"
        },
        {
          "command": "mcrh.openSyntaxPreview",
          "when": "resourceExtname == .json || resourceExtname == .mcmeta",
          "group": "navigation@3"
        },
        {
          "command": "mcrh.previewVanillaModel",
          "when": "resourceExtname =~ /^\\.png$/i",
          "group": "navigation@1"
        },
        {
          "command": "mcrh.openInBlockbench",
          "when": "resourceExtname =~ /^\\.bbmodel$/i || (resourceExtname =~ /^\\.json$/i && resourcePath =~ /[\\\\/]models[\\\\/]/)",
          "group": "mcrh@5"
        },
        {
          "command": "mcrh.previewGui",
          "when": "resourcePath =~ /[\\\\/]textures[\\\\/]gui[\\\\/]/ || resourceFilename == pack.mcmeta",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcrh",
          "title": "MCRH",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "mcrh": [
        {
          "id": "mcrh.sidebar",
          "name": "%view.mcrh.sidebar.name%",
          "type": "tree"
        },
        {
          "id": "mcrh.todos",
          "name": "TODO",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "mcrh.pixelEditor",
        "displayName": "%editor.mcrh.pixelEditor.name%",
        "selector": [
          {
            "filenamePattern": "assets/*/textures/**/*.png"
          },
          {
            "filenamePattern": "assets/*/optifine/**/*.png"
          },
          {
            "filenamePattern": "**/assets/*/textures/**/*.png"
          },
          {
            "filenamePattern": "**/assets/*/optifine/**/*.png"
          },
          {
            "filenamePattern": "pack.png"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MCRH",
      "properties": {
        "mcrh.hideTutorialOnStart": {
          "type": "boolean",
          "default": false,
          "description": "%setting.hideTutorialOnStart.description%"
        },
        "mcrh.defaultNamespace": {
          "type": "string",
          "default": "minecraft",
          "pattern": "^[a-z0-9_.-]+$",
          "description": "%setting.defaultNamespace.description%"
        },
        "mcrh.animationFrametime": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "description": "%setting.animationFrametime.description%"
        },
        "mcrh.ffmpegPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.ffmpegPath.description%"
        },
        "mcrh.blockbenchPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.blockbenchPath.description%"
        },
        "mcrh.scanDepth": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "%setting.scanDepth.description%"
        },
        "mcrh.scanExtraPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.scanExtraPaths.description%"
        },
        "mcrh.includeSnapshots": {
          "type": "boolean",
          "default": false,
          "description": "%setting.includeSnapshots.description%"
        },
        "mcrh.autoRefreshPackFormats": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoRefreshPackFormats.description%"
        },
        "mcrh.autoOpenSyntaxPreview": {
          "type": "boolean",
          "default": true,
          "description": "%setting.autoOpenSyntaxPreview.description%"
        },
        "mcrh.paintKeybindings": {
          "type": "object",
          "default": {},
          "description": "%setting.paintKeybindings.description%",
          "scope": "application",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mcrh.previewBaseAssetsPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.previewBaseAssetsPath.description%"
        },
        "mcrh.previewMinecraftVersion": {
          "type": "string",
          "default": "",
          "description": "%setting.previewMinecraftVersion.description%"
        },
        "mcrh.previewFallbackMinecraftVersion": {
          "type": "string",
          "default": "26.3",
          "description": "%setting.previewFallbackMinecraftVersion.description%"
        },
        "mcrh.previewAutoCacheVanilla": {
          "type": "boolean",
          "default": true,
          "description": "%setting.previewAutoCacheVanilla.description%"
        },
        "mcrh.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.mcp.enabled.description%"
        },
        "mcrh.collaboration.openp2pExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.collaboration.openp2pExecutable.description%"
        },
        "mcrh.collaboration.openp2pPresetUrl": {
          "type": "string",
          "default": "https://file.gldhn.top/file/json/preset.json",
          "scope": "machine",
          "description": "%setting.collaboration.openp2pPresetUrl.description%"
        },
        "mcrh.interfaceLanguage": {
          "type": "string",
          "enum": [
            "zh_cn",
            "en_us",
            "auto"
          ],
          "default": "zh_cn",
          "scope": "window",
          "description": "%language.setting%"
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.mcmeta": "json"
      }
    },
    "keybindings": [
      {
        "command": "undo",
        "key": "ctrl+z",
        "when": "editorFocus && resourceExtname == .png"
      },
      {
        "command": "redo",
        "key": "ctrl+y",
        "when": "editorFocus && resourceExtname == .png"
      }
    ],
    "languages": [
      {
        "id": "mcrh-optifine",
        "extensions": [
          ".properties"
        ],
        "filenames": [
          "cit_global.properties",
          "ctm_global.properties",
          "block.properties",
          "bettergrass.properties",
          "color.properties",
          "texture.properties",
          "dynamiclights.properties",
          "natural.properties",
          "random_entities.properties",
          "cem.properties",
          "emissive.properties"
        ],
        "configuration": "./language-configuration.json",
        "aliases": [
          "OptiFine Properties",
          "properties"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mcrh-optifine",
        "scopeName": "source.mcrh-optifine",
        "path": "./syntaxes/optifine.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "pack.mcmeta"
        ],
        "url": "./schemas/pack.mcmeta.schema.json"
      }
    ]
  },
  "files": [
    "out/extension.js",
    "out/collaboration-cli.cjs",
    "out/mcp-cli.cjs",
    "out/webview-repair.cjs",
    "out/data/clientAssetsWorker.cjs",
    "out/data/{*.json,licenses/**}",
    "out/data/conversion/*{.json,-LICENSE}",
    "out/data/totem/{*.json,LICENSE.md}",
    "out/data/lib-sources/block-model-renderer/package.json",
    "out/data/lib-sources/block-model-renderer/src/**/*.{js,json}",
    "out/webview/*.{js,css,ttf,svg}",
    "out/webview/logo.png",
    "out/webview/model-assets.zip",
    "out/webview/blockly-media/*.{gif,svg,png,cur,mp3,wav}",
    "images/icon.png",
    "images/icon.svg",
    "images/pack-default.png",
    "syntaxes/*.json",
    "schemas/*.json",
    "language-configuration.json",
    "README.vsix.md",
    "{LICENSE,CREDITS.md}",
    "out/data/openp2p/**",
    "locales/*.json",
    "package.nls*.json"
  ]
}
